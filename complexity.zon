// gnarl's path classes (github.com/kmoneil/gnarl). `zig build complexity`,
// and `zig build test` with it, runs `gnarl --check .`, which fails a
// function over a critical limit unless complexity.baseline holds it at
// that number or above.
.{
    // The release the code is judged by: a gnarl that counts otherwise
    // refuses --check, and CI installs this one (.github/workflows/ci.yml).
    .gnarl = "0.7.0",
    // What every parse runs: detection, the compiled program and the
    // detectors parse tries in turn. Named one by one, since a glob over
    // src would also take the test files (hot wins over cold on overlap).
    // natural.zig, the fallback for what no format matches, and the code
    // that runs once per format or column (format_string.zig, Column.zig)
    // stay normal.
    .hot = .{
        "src/root.zig",
        "src/Parser.zig",
        "src/Layout.zig",
        "src/signature.zig",
        "src/trie.zig",
        "src/detect.zig",
        "src/compile.zig",
        "src/fast.zig",
        "src/epoch.zig",
        "src/rfc2822.zig",
        "src/textual.zig",
        "src/ambiguity.zig",
        "src/DateTime.zig",
        "src/locale.zig",
        "src/unicode.zig",
    },
    // Test code, the build, tools and benches.
    .cold = .{ "build.zig", "tools/**", "bench/**", "src/*_test.zig", "testdata/**" },
    // Generated tables, not code: regenerated by `zig build locales` and
    // `zig build unicode`.
    .exclude = .{ "src/locale", "src/unicode_data.zig" },
}
